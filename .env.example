# Template only. Enter real values privately; never commit populated environment files.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=
STAFF_AUTH_ORIGIN=http://127.0.0.1:3001
STAFF_AUTH_ALLOW_LOCAL_HTTP=1
# Required absolute private storage directory, outside client/public and dist/public:
SOUTHSIDE_MEDIA_ROOT=
# Payments remain inactive. Do not put Paystack keys in this file.
SOUTHSIDE_PAYMENTS_MODE=disabled
SOUTHSIDE_PAYSTACK_WEBHOOKS=disabled
# Optional legacy platform services are unconfigured:
MANUS_API_URL=
MANUS_API_KEY=
